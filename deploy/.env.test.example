# Copy to deploy/.env.test on the test host. Never commit the real file.
COMPOSE_PROJECT_NAME=procurement-test
TEST_BIND_ADDRESS=127.0.0.1
TEST_HTTP_PORT=18080
TEST_BUILD_REF=local
TEST_DB_BASELINE_FILE=./db/test-init/runtime/001_baseline.sql

MYSQL_DATABASE=procurement_test
MYSQL_ROOT_PASSWORD=
MYSQL_USER=procurement_test
MYSQL_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=

# A 60-character BCrypt hash. Keep the value single-quoted because it contains '$'.
TEST_ADMIN_PASSWORD_HASH=''

TEST_MYSQL_MEMORY=2g
TEST_REDIS_MEMORY=512m
TEST_BACKEND_MEMORY=2g
TEST_FRONTEND_MEMORY=256m
TEST_FEISHU_EGRESS_MEMORY=128m

# Optional 151-only outbound notification integration. Keep the real values only
# in the host-managed deploy/.env.test file. The test environment never enables
# heartbeat delivery, long connections, or inbound bot events.
TEST_FEISHU_TEST_CARD_ENABLED=false
TEST_FEISHU_APP_ID=
TEST_FEISHU_APP_SECRET=
TEST_FEISHU_RECIPIENT_EMAIL=
