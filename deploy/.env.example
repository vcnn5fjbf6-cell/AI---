# Copy this file to deploy/.env on the server and fill real values there.
# Never commit deploy/.env or paste real secrets into tracked scripts/docs.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=procurement_platform
REDIS_PASSWORD=
QDRANT_ENABLED=true
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_PREFIX=procurement
JWT_SECRET=
FEISHU_AUTH_ENABLED=true
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=
FEISHU_ROOT_DEPARTMENT_ID=0
FEISHU_DEPARTMENT_ID_TYPE=department_id
FEISHU_DEPARTMENT_SEARCH_URL=https://open.feishu.cn/open-apis/contact/v3/departments/search
FEISHU_USER_DETAIL_URL=https://open.feishu.cn/open-apis/contact/v3/users/%s
FEISHU_USER_BATCH_GET_ID_URL=https://open.feishu.cn/open-apis/contact/v3/users/batch_get_id
FEISHU_USER_ID_TYPE=user_id
FEISHU_BOT_ENABLED=false
FEISHU_BOT_VERIFICATION_TOKEN=
FEISHU_APPROVAL_CARD_ENABLED=true
FEISHU_APPROVAL_CARD_HEARTBEAT_ENABLED=true
FEISHU_APPROVAL_CARD_LONG_CONNECTION_ENABLED=true
FEISHU_APPROVAL_CARD_VERIFICATION_TOKEN=
FEISHU_APPROVAL_CARD_ENCRYPT_KEY=
FEISHU_APPROVAL_CARD_APP_BASE_URL=http://your-intranet-host
FEISHU_APPROVAL_CARD_SYSTEM_ACTION_URL=
FEISHU_APPROVAL_CARD_RECEIVE_ID_TYPE=email
FEISHU_APPROVAL_CARD_DETAIL_ITEM_LIMIT=8
DIFY_PROCUREMENT_ENABLED=false
DIFY_PROCUREMENT_API_KEY=
DIFY_PROCUREMENT_APP_TYPE=agent
DIFY_PROCUREMENT_CHAT_MESSAGES_URL=https://api.dify.ai/v1/chat-messages
DIFY_PROCUREMENT_WORKFLOW_RUN_URL=https://api.dify.ai/v1/workflows/run
DIFY_PROCUREMENT_RESPONSE_MODE=streaming
# Required when /api/integrations/shopping is used; empty values are rejected.
SHOPPING_TOOL_TOKEN=
# Optional. Feedback image attachments are persisted here inside the backend container.
PLATFORM_FEEDBACK_STORAGE_DIR=
